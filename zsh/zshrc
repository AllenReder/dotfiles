# File: zshrc - Zsh entrypoint that loads modular configs.
# Entry point for zsh config.

setopt no_beep

DOTFILES_DIR="${0:A:h:h}"

# Load env first (PATH, editor, etc.).
[ -f "$DOTFILES_DIR/zsh/env.zsh" ] && source "$DOTFILES_DIR/zsh/env.zsh"

export ZSH="$HOME/.oh-my-zsh"

# Theme/plugins must be set before oh-my-zsh loads.
[ -f "$DOTFILES_DIR/zsh/plugins.zsh" ] && source "$DOTFILES_DIR/zsh/plugins.zsh"

if [ -f "$ZSH/oh-my-zsh.sh" ]; then
  source "$ZSH/oh-my-zsh.sh"
fi

[ -f "$DOTFILES_DIR/zsh/alias.zsh" ] && source "$DOTFILES_DIR/zsh/alias.zsh"
[ -f "$DOTFILES_DIR/zsh/functions.zsh" ] && source "$DOTFILES_DIR/zsh/functions.zsh"
[ -f "$DOTFILES_DIR/zsh/keybinds.zsh" ] && source "$DOTFILES_DIR/zsh/keybinds.zsh"
[ -f "$DOTFILES_DIR/zsh/prompt.zsh" ] && source "$DOTFILES_DIR/zsh/prompt.zsh"

# OS-specific tweaks.
case "$(uname -s)" in
  Darwin)
    [ -f "$DOTFILES_DIR/zsh/os/macos.zsh" ] && source "$DOTFILES_DIR/zsh/os/macos.zsh"
    ;;
  Linux)
    if [ -r /proc/version ] && grep -qi microsoft /proc/version; then
      [ -f "$DOTFILES_DIR/zsh/os/wsl.zsh" ] && source "$DOTFILES_DIR/zsh/os/wsl.zsh"
    else
      [ -f "$DOTFILES_DIR/zsh/os/linux.zsh" ] && source "$DOTFILES_DIR/zsh/os/linux.zsh"
    fi
    ;;
  *)
    ;;
 esac

# Host-specific tweaks (by hostname substring).
HOSTNAME_SHORT="$(hostname -s)"
HOST_MATCH=""
for f in "$DOTFILES_DIR"/zsh/host/*.zsh; do
  [ -f "$f" ] || continue
  base="${f:t:r}"
  if [[ "$HOSTNAME_SHORT" == *"$base"* ]]; then
    if [ -z "$HOST_MATCH" ] || [ ${#base} -gt ${#HOST_MATCH:t:r} ]; then
      HOST_MATCH="$f"
    fi
  fi
done
[ -n "$HOST_MATCH" ] && source "$HOST_MATCH"
