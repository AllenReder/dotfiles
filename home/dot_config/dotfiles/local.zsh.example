# Copy to ~/.config/dotfiles/local.zsh and keep real values out of git.

# Bark push.
# export BARK_SERVER="https://your-bark-server.example/push"
# export BARK_DEVICE_KEYS="device_key_1 device_key_2"

# Optional clashctl install path (default: $HOME/clashctl).
# export CLASHCTL_HOME="$HOME/path/to/clashctl"

# tmh model endpoint. Keep the real API key and private endpoint local.
# export TMH_BASE_URL="https://api.openai.com/v1"
# export TMH_MODEL="your-model-name"
# export TMH_API_KEY="your-api-key"
